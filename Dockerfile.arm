FROM arm64v8/node:24-bookworm-slim

ENV NODE_ENV=production

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npm cache clean --force

COPY server.js ./
COPY setup.js ./
COPY public ./public
COPY views ./views
COPY data ./data

RUN mkdir -p /app/data/uploads \
    && chown -R node:node /app

USER node

EXPOSE 3030
VOLUME ["/app/data"]

CMD ["node", "--max-old-space-size=64", "server.js"]
